# FastAPI / SQLite
DATABASE_URL=sqlite:///./impulse.db
SQLITE_BUSY_TIMEOUT_MS=30000
IMPULSE_DEBUG=true
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://localhost:8081
CORS_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Local GeoLite2 Country lookup
GEOIP_DATABASE_PATH=data/GeoLite2-Country.mmdb
TRUST_PROXY_HEADERS=false
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Open Icecat access tokens (leave blank until supplied)
ICECAT_API_ACCESS_TOKEN=
ICECAT_CONTENT_ACCESS_TOKEN=
ICECAT_INDEX_URL=https://data.icecat.biz/export/freexml/EN/files.index.csv.gz
ICECAT_TARGET_PRODUCTS=5000
ICECAT_CANDIDATE_BUFFER_PERCENT=20
ICECAT_CONCURRENCY=3
ICECAT_IMAGE_VALIDATION_CONCURRENCY=12

# Keyless public catalog endpoints and request identity
EXTERNAL_API_CONTACT=https://github.com/rshukla2/Impulse-FakeShoppingSimulator
EXTERNAL_API_TIMEOUT_SECONDS=30
EXTERNAL_API_MAX_RETRIES=3
FRANKFURTER_API_BASE=https://api.frankfurter.dev/v2
OPENFOODFACTS_API_BASE=https://world.openfoodfacts.org/api/v2
OPENFOODFACTS_COUNTRIES=US,IN,GB,JP,DE,FR,CA,AU,MX,BR,SG,AE,LK,NP,BD
OPENFOODFACTS_PRODUCTS_PER_COUNTRY=50
OPENFOODFACTS_MIN_INTERVAL_SECONDS=6.1
ENABLE_LAZY_COUNTRY_SYNC=false
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIMEDIA_API_ENDPOINT=https://commons.wikimedia.org/w/api.php
