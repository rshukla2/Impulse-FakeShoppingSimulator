[Unit]
Description=Update the Impulse GeoLite2 Country database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=impulse
Group=impulse
WorkingDirectory=/opt/impulse
EnvironmentFile=/opt/impulse/.env
ExecStart=/opt/impulse/.venv/bin/python /opt/impulse/scripts/update_geoip_database.py
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/impulse/storage
